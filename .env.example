# Roadside Radio Gateway configuration
# Copy to .env for local development or provide values via container environment.

NODE_ENV=production
LOG_LEVEL=info

# Public/source listener (Icecast-compatible presenter connections)
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8005
GATEWAY_PUBLIC_URL=https://broadcast.roadsideradio.co.uk:8005

# Admin/API HTTP server (bind internally; expose only via trusted reverse proxy/VPN if needed)
ADMIN_HOST=0.0.0.0
ADMIN_PORT=3000
ADMIN_BASE_URL=http://localhost:3000
TRUST_PROXY=false

# Persistent storage (mount a volume here)
DATA_DIR=/data
DATABASE_PATH=/data/gateway.sqlite

# Session/security (generate long random values; do not commit real secrets)
SESSION_SECRET=change-me-to-a-long-random-secret
SESSION_COOKIE_NAME=rrg_admin_session
SESSION_MAX_AGE_HOURS=12
SECURE_COOKIES=true

# Initial administrator bootstrap (used only when no admin account exists)
# Set these once for first startup, then remove or rotate them.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# Server-to-server BOP API authentication
# Provide a strong random key to BOP over a secure channel.
BOP_API_KEY=

# Internal Liquidsoap forwarding target (private Docker network; do not expose publicly)
LIQUIDSOAP_HOST=KGM-Liquidsoap
LIQUIDSOAP_PORT=9001
LIQUIDSOAP_MOUNT=/presenter
LIQUIDSOAP_USER=source
LIQUIDSOAP_PASSWORD=change-me
LIQUIDSOAP_PROTOCOL=put

# Rate limiting (tune as needed)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120

# Feature/operational flags
ALLOW_DUPLICATE_PRESENTER_CONNECTIONS=false
SOURCE_READ_TIMEOUT_MS=30000
FORWARD_CONNECT_TIMEOUT_MS=5000
